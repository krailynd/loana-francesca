---
import Base from '../layouts/Base.astro';
import RosaSVG from '../components/RosaSVG.astro';
import { Vales as ValesComponente } from '../components/Vales.tsx';
import { pareja } from '../data/datos.ts';

const nombreElla = pareja.para && pareja.para !== 'POR_COMPLETAR' ? pareja.para : 'Ti';
---

<Base
  titulo={`Talonario de Vales de Amor ❤ Para ${nombreElla}`}
  descripcion="8 cupones de amor canjeables con sello digital y fecha."
>
  <div class="py-4 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center justify-center p-2 rounded-full bg-[var(--rosa-palido)] mb-3">
      <RosaSVG variante="boton" color="rojo" size={24} />
    </div>
    <span class="text-xs uppercase tracking-widest text-[var(--granate)] font-bold block mb-1">
      Talonario de Cupones
    </span>
    <h1 class="text-3xl md:text-4xl font-serif-titulos font-bold text-[var(--granate)]">
      Vales de Amor Canjeables
    </h1>
    <p class="text-xs md:text-sm text-stone-600 mt-2 mb-8 max-w-md mx-auto">
      Cada cupón es una promesa que puedes reclamar cuando quieras. Una vez que pulses «Canjear», quedará sellado con la fecha de hoy.
    </p>

    <!-- Talonario con localStorage -->
    <ValesComponente client:load />

    <!-- Instrucciones físicas / print -->
    <div class="mt-12 p-4 bg-[var(--papel)] rounded-2xl border border-[var(--rosa-palido)] max-w-md mx-auto text-xs text-stone-500 text-center no-print">
      <p class="font-serif-titulos text-stone-700 font-semibold mb-1">
        💡 ¿Prefieres tenerlos en físico?
      </p>
      <p>
        Puedes imprimir esta pantalla con <kbd class="px-1.5 py-0.5 bg-stone-100 border rounded font-mono text-[10px]">Ctrl+P</kbd> y recortar los cupones para entregarlos en mano.
      </p>
    </div>
  </div>
</Base>
