---
import Base from '../layouts/Base.astro';
import RosaSVG from '../components/RosaSVG.astro';
import { mensajesQR, pareja } from '../data/datos.ts';

const nombreElla = pareja.para && pareja.para !== 'POR_COMPLETAR' ? pareja.para : 'Ti';
---

<Base
  titulo={`Tarjetas QR Imprimibles ❤ Para ${nombreElla}`}
  descripcion="Seis tarjetas con códigos QR offline listas para imprimir en formato A4 y regalar en mano."
>
  <div class="py-4 text-center max-w-4xl mx-auto">
    <!-- Encabezado en pantalla (oculto en impresión) -->
    <div class="no-print max-w-xl mx-auto mb-8">
      <div class="inline-flex items-center justify-center p-2 rounded-full bg-[var(--rosa-palido)] mb-3">
        <RosaSVG variante="boton" color="rojo" size={24} />
      </div>
      <span class="text-xs uppercase tracking-widest text-[var(--granate)] font-bold block mb-1">
        Detalle Físico & Offline
      </span>
      <h1 class="text-3xl md:text-4xl font-serif-titulos font-bold text-[var(--granate)]">
        Tarjetas con Código QR
      </h1>
      <p class="text-xs md:text-sm text-stone-600 mt-2 mb-6">
        Estas 6 tarjetas están diseñadas para imprimirse en una sola hoja A4. Cada código contiene un mensaje romántico en texto puro: <strong>tu pareja no necesita internet ni abrir ninguna web</strong> para leerlo con la cámara de su celular.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-3">
        <button
          type="button"
          onclick="window.print()"
          class="btn-romantico px-8 py-3 bg-[var(--granate)] hover:bg-[var(--rojo)] text-[var(--papel)] rounded-full text-sm font-semibold shadow-md flex items-center gap-2"
        >
          <span>🖨️</span>
          <span>Imprimir hoja A4 de tarjetas</span>
        </button>
      </div>

      <div class="p-3 bg-amber-50 border border-amber-200/80 rounded-xl text-xs text-amber-900 mt-4 max-w-md mx-auto">
        💡 <strong>Recomendación:</strong> Usa cartulina opalina o papel fotográfico mate para un acabado elegante, y recórtalas por las líneas punteadas.
      </div>
    </div>

    <!-- HOJA IMPRIMIBLE DE TARJETAS (Grilla de 6 tarjetas ajustada a A4) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 hoja-imprimible text-left">
      {mensajesQR.map((item, idx) => (
        <div class="tarjeta-qr-fisica bg-white p-6 rounded-2xl border-2 border-dashed border-[#D5C2B0] shadow-xs flex flex-col justify-between items-center text-center relative overflow-hidden">
          {/* Esquinas decorativas */}
          <div class="w-full flex items-center justify-between text-[10px] text-stone-400 uppercase tracking-widest font-semibold pb-2 border-b border-stone-100">
            <span>Tarjeta #{idx + 1}</span>
            <RosaSVG variante="boton" color="rojo" size={14} />
          </div>

          {/* Título de la tarjeta */}
          <div class="my-3">
            <h3 class="font-serif-titulos font-bold text-lg text-[var(--granate)] leading-tight">
              {item.tituloTarjeta}
            </h3>
            <p class="text-[11px] text-stone-500 mt-0.5">
              {item.subtitulo}
            </p>
          </div>

          {/* Imagen SVG del código QR offline */}
          <div class="my-2 p-2 bg-[#FFFDF8] rounded-xl border border-stone-200 shadow-inner">
            <img
              src={`/qr/${item.id}.svg`}
              alt={`Código QR para ${item.tituloTarjeta}`}
              class="w-36 h-36 md:w-40 md:h-40 mx-auto select-none"
              loading="lazy"
            />
          </div>

          {/* Indicación de escaneo */}
          <div class="mt-3 pt-2 border-t border-stone-100 w-full text-center">
            <span class="text-[10px] text-stone-400 font-sans block">
              Escanea con la cámara de tu celular
            </span>
            <span class="text-[11px] text-[var(--rojo)] font-manuscrita text-base font-bold block mt-0.5">
              {pareja.para ? `Para ${pareja.para} ❤` : 'Con todo mi amor'}
            </span>
          </div>

          {/* Tijeras sutiles en la esquina */}
          <div class="absolute -top-3 -right-3 w-6 h-6 rounded-full bg-stone-100 border border-stone-300 flex items-center justify-center text-[10px] text-stone-400 pointer-events-none no-print">
            ✂️
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>
