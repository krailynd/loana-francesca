---
import '../styles/global.css';
import RosaSVG from '../components/RosaSVG.astro';
import { PetalosCanvas } from '../components/PetalosCanvas.tsx';
import { AccesoFecha } from '../components/AccesoFecha.tsx';
import { pareja } from '../data/datos.ts';

export interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Para Ti ❤ Un rincón especial',
  descripcion = 'Un detalle digital hecho con amor y momentos compartidos.',
} = Astro.props;

const pathname = Astro.url.pathname;

const rutasNav = [
  { href: '/', etiqueta: 'Inicio' },
  { href: '/carta', etiqueta: 'Carta' },
  { href: '/juegos', etiqueta: 'Juegos' },
  { href: '/razones', etiqueta: '12 Razones' },
  { href: '/vales', etiqueta: 'Vales' },
  { href: '/sobres', etiqueta: 'Sobres' },
  { href: '/historia', etiqueta: 'Historia' },
  { href: '/playlist', etiqueta: 'Canciones' },
  { href: '/tarjetas-qr', etiqueta: 'Imprimir QR' },
  { href: '/final', etiqueta: 'Cierre' },
];

const nombreElla = pareja.para && pareja.para !== 'POR_COMPLETAR' ? pareja.para : 'Ti';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#5C1620" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph para compartir bonito -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />

    <!-- Tipografías de Google Fonts: Cormorant Garamond, Marck Script, Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Marck+Script&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--crema)] text-[var(--tinta)] antialiased font-sans relative selection:bg-[var(--rosa)] selection:text-[var(--granate)]">
    <!-- Lluvia sutil de pétalos de rosa animados en segundo plano -->
    <PetalosCanvas client:load cantidad={20} />

    <!-- Bloqueo opcional por fecha de inicio (si está activo en datos.ts) -->
    <AccesoFecha client:load>
      <!-- NAVEGACIÓN SUPERIOR HEADER -->
      <header class="sticky top-0 z-40 bg-[var(--papel)]/90 backdrop-blur-md border-b border-[var(--rosa-palido)] shadow-xs no-print transition-all">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
          <!-- Logo con RosaSVG -->
          <a
            href="/"
            class="flex items-center gap-2.5 group py-1"
            aria-label="Ir a la página de inicio"
          >
            <RosaSVG variante="abierta" color="rojo" size={32} class="transform group-hover:scale-110 transition-transform duration-300" />
            <span class="font-serif-titulos text-xl md:text-2xl font-bold tracking-tight text-[var(--granate)]">
              Para {nombreElla}
            </span>
          </a>

          <!-- Menú escritorio -->
          <nav class="hidden lg:flex items-center gap-1">
            {rutasNav.map((item) => {
              const activa = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`px-3 py-1.5 rounded-full text-xs font-semibold transition-all ${
                    activa
                      ? 'bg-[var(--granate)] text-[var(--papel)] shadow-xs'
                      : 'text-[var(--tinta)] hover:text-[var(--rojo)] hover:bg-[var(--rosa-palido)]'
                  }`}
                >
                  {item.etiqueta}
                </a>
              );
            })}
          </nav>

          <!-- Botón Menú Móvil -->
          <button
            id="btn-menu-movil"
            type="button"
            class="lg:hidden p-2 rounded-xl text-[var(--granate)] hover:bg-[var(--rosa-palido)] focus:outline-none transition-colors"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </button>
        </div>

        <!-- Cajón de navegación desplegable en móviles -->
        <div
          id="cajon-menu-movil"
          class="hidden lg:hidden border-t border-[var(--rosa-palido)] bg-[var(--papel)] px-4 py-4 space-y-1 shadow-lg animate-fadeIn"
        >
          <div class="grid grid-cols-2 gap-2">
            {rutasNav.map((item) => {
              const activa = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between min-h-[44px] transition-all ${
                    activa
                      ? 'bg-[var(--granate)] text-[var(--papel)]'
                      : 'bg-[var(--crema)] text-[var(--tinta)] hover:bg-[var(--rosa-palido)]'
                  }`}
                >
                  <span>{item.etiqueta}</span>
                  {activa && <span class="text-xs">❤</span>}
                </a>
              );
            })}
          </div>
        </div>
      </header>

      <!-- CONTENIDO PRINCIPAL -->
      <main class="flex-1 relative z-10 w-full max-w-5xl mx-auto px-4 py-8 md:py-12">
        <slot />
      </main>

      <!-- PIE DE PÁGINA FOOTER -->
      <footer class="relative z-10 border-t border-[var(--rosa-palido)] bg-[var(--papel)]/80 py-8 text-center text-xs text-stone-500 no-print">
        <div class="max-w-md mx-auto px-4 flex flex-col items-center">
          <RosaSVG variante="boton" color="rojo" size={24} class="mb-3 opacity-80" />
          <p class="font-serif-titulos text-base text-[var(--granate)] font-semibold mb-1">
            Hecho con amor para {nombreElla}
          </p>
          <p class="text-[11px] text-stone-400 font-manuscrita text-lg">
            «El amor está en los pequeños detalles que construimos cada día»
          </p>
          <div class="mt-4 pt-3 border-t border-stone-200/60 w-full flex justify-center gap-4 text-[11px]">
            <a href="/carta" class="hover:text-[var(--rojo)] underline">Leer carta</a>
            <span>•</span>
            <a href="/juegos" class="hover:text-[var(--rojo)] underline">Jugar juntos</a>
            <span>•</span>
            <a href="/tarjetas-qr" class="hover:text-[var(--rojo)] underline">Tarjetas QR</a>
          </div>
        </div>
      </footer>
    </AccesoFecha>

    <!-- Script ligero para alternar menú móvil -->
    <script is:inline>
      const btn = document.getElementById('btn-menu-movil');
      const cajon = document.getElementById('cajon-menu-movil');

      if (btn && cajon) {
        btn.addEventListener('click', () => {
          const abierto = !cajon.classList.contains('hidden');
          if (abierto) {
            cajon.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            cajon.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      }
    </script>
  </body>
</html>
